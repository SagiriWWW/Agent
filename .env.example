# Provider options:
# - openai: use OPENAI_API_KEY / OPENAI_MODEL
# - bailian: use DASHSCOPE_API_KEY / BAILIAN_MODEL / BAILIAN_BASE_URL
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=

# Alibaba Cloud Model Studio / 百炼 / DashScope OpenAI-compatible API
DASHSCOPE_API_KEY=sk-...
BAILIAN_MODEL=qwen-plus
# 中国内地（北京地域）默认 endpoint:
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 美国（弗吉尼亚）可改为:
# BAILIAN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
# 新加坡地域按百炼文档需填 WorkspaceId:
# BAILIAN_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

AGENT_MVP_STORAGE_DIR=runtime
AGENT_MVP_FORCE_MODEL_API=0
AGENT_MVP_MAX_TOOL_STEPS=10

# Optional: local FP-growth-only backend with scripts/core/fpgrowth_core.py.
# The project auto-detects third_party/Datamining. Set this only if your backend is elsewhere.
DATAMINING_REPO_PATH=
# Optional: direct path to a Python file exposing fpgrowth / association_rules / is_same_sensor_rule.
DATAMINING_FPGROWTH_CORE_PATH=
