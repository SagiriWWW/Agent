# Offline demo needs no API key. Copy to .env and configure only for model calls.
LLM_PROVIDER=local_demo
AGENT_MVP_STORAGE_DIR=outputs/runs
AGENT_MVP_FORCE_MODEL_API=0
AGENT_MVP_MAX_TOOL_STEPS=10

# OpenAI-compatible endpoint (optional; use your own values).
# LLM_PROVIDER=custom_openai
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_API_PROTOCOL=chat_completions
# AGENT_MVP_FORCE_MODEL_API=1
